<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- App Store Connect, not Developer ID. See release.yml's header for why
	     there is no notarisation step: App Store builds are notarised by
	     Apple during review, and notarytool is for the direct-download
	     channel this project does not currently have. -->
	<key>method</key>
	<string>app-store-connect</string>
	<key>teamID</key>
	<string>TATYN4X57D</string>
	<!-- Uploads straight from xcodebuild rather than exporting a .pkg and
	     handing it to a second tool. -->
	<key>destination</key>
	<string>upload</string>
	<!-- Automatic: xcodebuild -exportArchive, given the App Store Connect API
	     key and -allowProvisioningUpdates, fetches the App Store profile and
	     signs with the team's cloud-managed Apple Distribution certificate.
	     No distribution certificate or profile is stored as a secret. The
	     key must have the Admin role; any other role gets "Cloud signing
	     permission error". -->
	<key>signingStyle</key>
	<string>automatic</string>
	<key>uploadSymbols</key>
	<true/>
	<!-- Never let the exporter invent a version. release.yml sets the build
	     number from the workflow run, and the release gate has already checked
	     the marketing version against the tag. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
