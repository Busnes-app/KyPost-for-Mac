<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Developer ID, not the Mac App Store. The Mac app is distributed as a
	     notarised disk image on GitHub Releases; release.yml notarises and
	     staples it after this export. -->
	<key>method</key>
	<string>developer-id</string>
	<key>teamID</key>
	<string>TATYN4X57D</string>
	<!-- Writes KyPost.app to -exportPath for release.yml to package. -->
	<key>destination</key>
	<string>export</string>
	<!-- Automatic: xcodebuild -exportArchive, given the App Store Connect API
	     key and -allowProvisioningUpdates, fetches the Developer ID profile
	     the push and keychain-group entitlements need. It signs with the
	     Developer ID Application identity release.yml imports from a secret:
	     cloud signing cannot do Developer ID. -->
	<key>signingStyle</key>
	<string>automatic</string>
	<!-- Never let the exporter invent a version. release.yml sets the build
	     number from the workflow run, and the release gate has already checked
	     the marketing version against the tag. -->
	<key>manageAppVersionAndBuildNumber</key>
	<false/>
</dict>
</plist>
